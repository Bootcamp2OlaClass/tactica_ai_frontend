# Local development values only. Replace these outside local development.

# Base URL of the backend API this frontend talks to. Inlined into the
# JavaScript bundle at build time (Next.js only exposes NEXT_PUBLIC_* vars
# to the browser, and does so at build, not at runtime) -- a production
# build needs this set correctly *before* `next build` runs, not just at
# container start.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Optional -- only used by `npm run test:e2e` (Playwright) to point at a
# frontend server other than the default http://localhost:3000.
# E2E_BASE_URL=http://localhost:3000
